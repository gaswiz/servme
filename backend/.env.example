# Backend environment. Copy to backend/.env and fill in real values.
# Never commit backend/.env.
DB_HOST=localhost
DB_USER=servme_app
DB_PASSWORD=change-me
DB_NAME=servme

# Required. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime (jsonwebtoken / vercel-ms format)
JWT_EXPIRES_IN=7d

PORT=3001

# Comma-separated list of browser origins allowed by CORS (Expo web dev server by default).
# Native iOS/Android clients are not affected by CORS.
CORS_ORIGIN=http://localhost:8081
